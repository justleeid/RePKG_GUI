{
  "App": {
    "Name": "RePKG GUI",
    "Version": "0.1.0"
  },
  "Cache": {
    "MemoryMaxItems": 500,
    "DiskMaxBytes": 524288000,
    "ThumbnailDecodeWidth": 200
  },
  "Scan": {
    "MaxConcurrency": 4,
    "DefaultWorkshopPath": "steamapps\\workshop\\content\\431960"
  },
  "Extract": {
