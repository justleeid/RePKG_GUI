    "ConvertTexToImage": true,
    "OverwriteExisting": false
  },
  "UI": {
    "DefaultViewMode": "Grid",
    "Theme": "System",
    "Language": "zh-CN",
    "DetailPanelDefaultOpen": false
  }
}
