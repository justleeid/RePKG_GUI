<Window x:Class="RePKG.WpfGui.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RePKG.WpfGui.ViewModels"
        xmlns:controls="clr-namespace:RePKG.WpfGui.Views.Controls"
        xmlns:views="clr-namespace:RePKG.WpfGui.Views"
        Title="RePKG GUI - Wallpaper Engine 解包工具"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundBrush}"
        AllowDrop="True"
        DragEnter="OnDragEnter"
        DragLeave="OnDragLeave"
        Drop="OnDrop">

    <Window.InputBindings>
        <KeyBinding Key="A" Modifiers="Control" Command="{Binding SelectAllCommand}"/>
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding DeselectAllCommand}"/>
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand}"/>
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelScanCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========== 工具栏 ========== -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <!-- 右侧：主题切换 -->
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                        Content="{Binding ThemeToggleText}" FontSize="18"
                        Command="{Binding ToggleThemeCommand}"
                        ToolTip="切换深色/浅色模式" Padding="8,4"/>

                <!-- 左侧：功能按钮 -->
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource PrimaryButton}" Content="📂 打开目录"
                            Command="{Binding OpenDirectoryCommand}" Padding="16,8" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource ModernButton}" Content="🔄 扫描检测目录"
                            Command="{Binding ScanDetectedDirectoryCommand}" Padding="16,8" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource ModernButton}" Content="{Binding ViewModeToggleText}"
                            Command="{Binding ToggleViewModeCommand}" Padding="16,8" Margin="0,0,8,0"/>
                    <Separator Margin="8,0" VerticalAlignment="Center" Height="20"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="📦 解包选中"
                            Command="{Binding ExtractSelectedCommand}" Padding="16,8" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource ModernButton}" Content="全选"
                            Command="{Binding SelectAllCommand}" Padding="12,8" Margin="0,0,4,0"/>
                    <Button Style="{StaticResource ModernButton}" Content="取消全选"
                            Command="{Binding DeselectAllCommand}" Padding="12,8" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource IconButton}" Content="⏹ 取消"
                            Command="{Binding CancelScanCommand}"
                            Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ========== 主内容区 ========== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 分类标题 -->
                    <TextBlock Grid.Row="0" Text="分类筛选" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                               Margin="16,16,16,8"/>

                    <!-- 分类列表 -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding Categories}"
                             SelectedItem="{Binding SelectedCategory}"
                             Style="{x:Null}"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource NavigationItem}"
                             Margin="8,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Name}"/>
                                    <TextBlock Text="{Binding Count, StringFormat=' ({0})'}"
                                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="4,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 路径显示 -->
                    <Border Grid.Row="2" Background="{DynamicResource BackgroundBrush}" Padding="12" Margin="8,8"
                            CornerRadius="4" ToolTip="{Binding DetectedWorkshopPath}">
                        <StackPanel>
                            <TextBlock Text="Wallpaper Engine 目录" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding DetectedWorkshopPath, FallbackValue='未检测到'}"
                                       FontSize="12" TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 右侧内容区 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 搜索和状态栏 -->
                <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 搜索框 -->
                        <TextBox Grid.Column="0" Style="{StaticResource SearchBox}"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 MaxWidth="300" HorizontalAlignment="Left"
                                 x:Name="SearchBox"/>

                        <!-- 排序和统计 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalCount, StringFormat='共 {0} 个'}"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding SelectedCount, StringFormat='已选 {0} 个'}"
                                       Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold"
                                       VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <Button Style="{StaticResource IconButton}" Content="↑↓"
                                    Command="{Binding ToggleSortDirectionCommand}"
                                    ToolTip="{Binding SortDirectionText}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 壁纸列表区域 -->
                <Grid Grid.Row="1" Margin="16,8">

                    <!-- 网格视图 -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsGridView, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding WallpaperItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:WallpaperItemViewModel}">
                                    <controls:WallpaperCard/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 列表视图 -->
                    <DataGrid ItemsSource="{Binding WallpaperItems}"
                              SelectedItem="{Binding SelectedItem}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              GridLinesVisibility="None"
                              BorderThickness="0"
                              Background="Transparent"
                              Visibility="{Binding IsListView, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DataGridCellSelectedBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Height" Value="48"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DataGridSelectedBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DataGridHoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Binding="{Binding IsSelected, Mode=TwoWay}" Width="40"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding TypeIcon}" Width="50"/>
                            <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="作者" Binding="{Binding Author}" Width="120"/>
                            <DataGridTextColumn Header="大小" Binding="{Binding FileSizeDisplay}" Width="80"/>
                            <DataGridTextColumn Header="ID" Binding="{Binding WorkshopId}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ========== 详情面板 ========== -->
        <views:MetadataPanel Grid.Row="2"
                             DataContext="{Binding MetadataPanel}"
                             Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!-- ========== 状态栏 ========== -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" FontSize="12" Margin="16,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center">
                    <Run Text="共 "/>
                    <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                    <Run Text=" 个"/>
                </TextBlock>

                <TextBlock Grid.Column="2" FontSize="12" Margin="0,0,16,0"
                           Foreground="{DynamicResource PrimaryBrush}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center">
                    <Run Text="已选 "/>
                    <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
                    <Run Text=" 个"/>
                </TextBlock>

                <TextBlock Grid.Column="3" Text="{Binding CacheDisplay}" FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ========== 进度指示器 ========== -->
        <Border Grid.Row="4" Background="{DynamicResource PrimaryBrush}" Padding="8"
                Visibility="{Binding IsExtracting, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="正在解包..." Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <!-- ========== 拖拽覆盖层 ========== -->
        <Border x:Name="DragOverlay" Grid.RowSpan="5"
                Background="#CC1B1B1B" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="📂" FontSize="64" HorizontalAlignment="Center"/>
                <TextBlock Text="释放以扫描此目录" FontSize="20" FontWeight="SemiBold"
                           Foreground="White" HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
