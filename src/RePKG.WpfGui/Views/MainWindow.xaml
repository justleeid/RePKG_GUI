<Window x:Class="RePKG.WpfGui.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RePKG.WpfGui.ViewModels"
        xmlns:controls="clr-namespace:RePKG.WpfGui.Views.Controls"
        xmlns:views="clr-namespace:RePKG.WpfGui.Views"
        Title="RePKG GUI - Wallpaper Engine 解包工具"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragEnter="OnDragEnter"
        DragLeave="OnDragLeave"
        Drop="OnDrop">

    <Window.InputBindings>
        <KeyBinding Key="A" Modifiers="Control" Command="{Binding SelectAllCommand}"/>
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding DeselectAllCommand}"/>
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand}"/>
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelScanCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 菜单栏 -->
        <Menu Grid.Row="0">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="打开目录(_O)" Command="{Binding OpenDirectoryCommand}"/>
                <Separator/>
                <MenuItem Header="退出(_X)" Click="OnExitClick"/>
            </MenuItem>
            <MenuItem Header="编辑(_E)">
                <MenuItem Header="全选(_A)" Command="{Binding SelectAllCommand}" InputGestureText="Ctrl+A"/>
                <MenuItem Header="取消全选(_D)" Command="{Binding DeselectAllCommand}" InputGestureText="Ctrl+D"/>
            </MenuItem>
            <MenuItem Header="视图(_V)">
                <MenuItem Header="切换视图模式" Command="{Binding ToggleViewModeCommand}"/>
                <Separator/>
                <MenuItem Header="刷新(_R)" Command="{Binding RefreshCommand}"/>
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="关于(_A)" Click="OnAboutClick"/>
            </MenuItem>
        </Menu>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,4">
            <Button Content="📁 打开目录" Command="{Binding OpenDirectoryCommand}" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="🔄 扫描检测目录" Command="{Binding ScanDetectedDirectoryCommand}" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="{Binding ViewModeToggleText}" Command="{Binding ToggleViewModeCommand}" Padding="12,6" Margin="0,0,8,0"/>

            <Separator Margin="8,0"/>

            <Button Content="📦 解包选中" Command="{Binding ExtractSelectedCommand}" Padding="12,6" Margin="0,0,8,0"
                    Background="#0078D4" Foreground="White"/>

            <Separator Margin="8,0"/>

            <!-- 搜索框 -->
            <TextBox x:Name="SearchBox" Width="200" VerticalAlignment="Center"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="8,0"/>

            <Separator Margin="8,0"/>

            <TextBlock VerticalAlignment="Center" Margin="8,0">
                <Run Text="Steam: "/>
                <Run Text="{Binding DetectedWorkshopPath, FallbackValue='未检测到'}" FontWeight="SemiBold"/>
            </TextBlock>

            <Button Content="⏹ 取消" Command="{Binding CancelScanCommand}" Padding="12,6" Margin="16,0,0,0"
                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </StackPanel>

        <!-- 主内容区 -->
        <Grid Grid.Row="2" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 网格视图 -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsGridView, Converter={StaticResource BoolToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding WallpaperItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:WallpaperItemViewModel}">
                            <controls:WallpaperCard/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 列表视图 -->
            <DataGrid Grid.Row="0"
                      ItemsSource="{Binding WallpaperItems}"
                      SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F9F9F9"
                      Visibility="{Binding IsListView, Converter={StaticResource BoolToVisibilityConverter}}">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Binding="{Binding IsSelected, Mode=TwoWay}" Width="40"/>
                    <DataGridTextColumn Header="类型" Binding="{Binding TypeIcon}" Width="50"/>
                    <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="作者" Binding="{Binding Author}" Width="150"/>
                    <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="100"/>
                    <DataGridTextColumn Header="大小" Binding="{Binding FileSizeDisplay}" Width="100"/>
                    <DataGridTextColumn Header="Workshop ID" Binding="{Binding WorkshopId}" Width="120"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Height" Value="32"/>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>

            <!-- 详情面板 -->
            <views:MetadataPanel Grid.Row="1"
                                 DataContext="{Binding MetadataPanel}"
                                 Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock>
                    <Run Text="共 "/>
                    <Run Text="{Binding TotalCount}"/>
                    <Run Text=" 个壁纸"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock>
                    <Run Text="已选 "/>
                    <Run Text="{Binding SelectedCount}"/>
                    <Run Text=" 个"/>
                </TextBlock>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="200" Height="16"
                             IsIndeterminate="{Binding IsScanning}"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- 进度指示器 -->
        <Border Grid.Row="4" Background="#0078D4" Padding="8"
                Visibility="{Binding IsExtracting, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="正在解包..." Foreground="White" HorizontalAlignment="Center"/>
        </Border>

        <!-- 拖拽导入覆盖层 -->
        <Border x:Name="DragOverlay" Grid.RowSpan="5"
                Background="#800078D4" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="📁" FontSize="64" HorizontalAlignment="Center"/>
                <TextBlock Text="释放以扫描此目录" FontSize="24" FontWeight="SemiBold"
                           Foreground="White" HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
