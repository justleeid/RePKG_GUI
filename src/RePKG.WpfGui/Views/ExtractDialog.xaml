<Window x:Class="RePKG.WpfGui.Views.ExtractDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="解包选项"
        Width="420" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        MinWidth="360" MinHeight="500"
        Background="{StaticResource BackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 内容区 -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Margin="16,12,16,0">
            <StackPanel>
                <!-- 输出目录 -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="输出目录"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Style="{StaticResource SearchBox}"
                                     Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Style="{StaticResource ModernButton}"
                                    Content="浏览" Command="{Binding BrowseOutputDirectoryCommand}"
                                    Padding="16,8" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 基本选项 -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="基本选项"/>
                        <CheckBox Style="{StaticResource FluentCheckBox}"
                                  Content="使用壁纸名称作为子文件夹"
                                  IsChecked="{Binding UseNameAsFolder}"/>
                        <CheckBox Style="{StaticResource FluentCheckBox}"
                                  Content="所有文件放在同一个目录下"
                                  IsChecked="{Binding SingleDirectory}"/>
                        <CheckBox Style="{StaticResource FluentCheckBox}"
                                  Content="转换 TEX 为图片 (PNG)"
                                  IsChecked="{Binding ConvertTexToImage}"/>
                        <CheckBox Style="{StaticResource FluentCheckBox}"
                                  Content="复制项目文件"
                                  IsChecked="{Binding CopyProjectFiles}"/>
                        <CheckBox Style="{StaticResource FluentCheckBox}"
                                  Content="覆盖已存在的文件"
                                  IsChecked="{Binding OverwriteExisting}" Margin="0,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 文件过滤 -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="文件过滤"/>
                        <RadioButton Style="{StaticResource FluentRadioButton}"
                                     Content="提取全部文件"
                                     GroupName="FileFilter" IsChecked="True"/>
                        <RadioButton Style="{StaticResource FluentRadioButton}"
                                     Content="仅提取图片 (.png, .jpg)"
                                     GroupName="FileFilter"
                                     IsChecked="{Binding FilterImagesOnly}"/>
                        <RadioButton Style="{StaticResource FluentRadioButton}"
                                     Content="仅提取模型 (.obj, .fbx)"
                                     GroupName="FileFilter"
                                     IsChecked="{Binding FilterModelsOnly}"/>
                        <RadioButton Style="{StaticResource FluentRadioButton}"
                                     Content="排除音频文件 (.wav, .mp3, .ogg)"
                                     GroupName="FileFilter"
                                     IsChecked="{Binding ExcludeAudio}" Margin="0,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 信息 -->
                <Border Background="#F0F7FF" CornerRadius="6" Padding="14,10" Margin="0,0,0,4">
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#005A9E">
                        <Run Text="将解包 "/>
                        <Run Text="{Binding SelectedCount}" FontWeight="SemiBold"/>
                        <Run Text=" 个壁纸到指定目录"/>
                    </TextBlock>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 按钮区（固定在底部） -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ModernButton}" Content="取消"
                        Command="{Binding CancelCommand}" Padding="24,8" Margin="0,0,12,0"/>
                <Button Style="{StaticResource PrimaryButton}" Content="开始解包"
                        Command="{Binding ConfirmCommand}" Padding="24,8"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
