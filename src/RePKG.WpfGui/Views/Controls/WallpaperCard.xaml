<UserControl x:Class="RePKG.WpfGui.Views.Controls.WallpaperCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:RePKG.WpfGui.Converters"
             Width="220" Height="280">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Border Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="1"
            CornerRadius="8"
            Margin="4"
            Padding="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" Opacity="0.1" ShadowDepth="2"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="200"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 缩略图 -->
            <Border Grid.Row="0" CornerRadius="4" Background="#F0F0F0" ClipToBounds="True">
                <Grid>
                    <!-- 缩略图图片 -->
                    <Image Source="{Binding PreviewImage}"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                    <!-- 加载中占位符 -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding IsLoadingPreview, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="⏳" FontSize="32" HorizontalAlignment="Center"/>
                        <TextBlock Text="加载中..." FontSize="12" Foreground="#9E9E9E" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- 类型图标 -->
                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="#99000000"
                            CornerRadius="4"
                            Margin="4"
                            Padding="4">
                        <TextBlock Text="{Binding TypeIcon}" FontSize="14" Foreground="White"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 标题 -->
            <TextBlock Grid.Row="1"
                       Text="{Binding Title}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="#1A1A1A"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,8,0,2"/>

            <!-- 作者 -->
            <TextBlock Grid.Row="2"
                       Text="{Binding Author}"
                       FontSize="12"
                       Foreground="#616161"
                       TextTrimming="CharacterEllipsis"/>

            <!-- 大小 -->
            <TextBlock Grid.Row="3"
                       Text="{Binding FileSizeDisplay}"
                       FontSize="12"
                       Foreground="#9E9E9E"/>
        </Grid>
    </Border>
</UserControl>
