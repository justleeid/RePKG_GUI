<UserControl x:Class="RePKG.WpfGui.Views.Controls.WallpaperCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:RePKG.WpfGui.Converters"
             Width="200" Height="240"
             MouseLeftButtonDown="OnMouseLeftButtonDown"
             Cursor="Hand">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Border x:Name="CardBorder"
            BorderThickness="1"
            CornerRadius="8"
            Margin="6"
            Padding="0"
            BorderBrush="{DynamicResource BorderBrush}"
            Background="{DynamicResource SurfaceBrush}"
            RenderTransformOrigin="0.5,0.5">
        <Border.Effect>
            <DropShadowEffect x:Name="CardShadow" BlurRadius="10" Opacity="0.08" ShadowDepth="2"/>
        </Border.Effect>
        <Border.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                     To="1.03" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                     To="1.03" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(Effect).ShadowDepth"
                                                     To="6" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(Effect).Opacity"
                                                     To="0.15" Duration="0:0:0.15"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>
                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                     To="1" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY"
                                                     To="1" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(Effect).ShadowDepth"
                                                     To="2" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(Effect).Opacity"
                                                     To="0.08" Duration="0:0:0.15"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="160"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 缩略图区域 -->
            <Border Grid.Row="0" CornerRadius="8,8,0,0" Background="{DynamicResource BackgroundBrush}" ClipToBounds="True">
                <Grid>
                    <!-- 缩略图图片 -->
                    <Image Source="{Binding PreviewImage}"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                    <!-- 加载中占位符 -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding IsLoadingPreview, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="⏳" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="加载中" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- 无预览图占位符 -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding HasNoPreview, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="🖼️" FontSize="36" HorizontalAlignment="Center" Opacity="0.3"/>
                    </StackPanel>

                    <!-- 类型图标 -->
                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="#CC000000"
                            CornerRadius="4,4,0,0"
                            Padding="8,4">
                        <TextBlock Text="{Binding TypeIcon}" FontSize="12" Foreground="White"/>
                    </Border>

                    <!-- 选中勾选标记 -->
                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="8"
                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="12" Width="24" Height="24">
                            <TextBlock Text="✓" FontSize="14" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Border>

                    <!-- 扫描失败标记 -->
                    <Border HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Margin="8"
                            Visibility="{Binding IsScanFailed, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="#D13438" CornerRadius="12" Padding="8,2">
                            <TextBlock Text="失败" FontSize="10" Foreground="White"/>
                        </Border>
                    </Border>
                </Grid>
            </Border>

            <!-- 信息区域 -->
            <Border Grid.Row="1" Padding="10,8">
                <StackPanel>
                    <!-- 标题 -->
                    <TextBlock Text="{Binding Title}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Margin="0,0,0,2"/>

                    <!-- 作者（可选显示） -->
                    <TextBlock Text="{Binding Author}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasAuthor, Converter={StaticResource BoolToVisibilityConverter}}"
                               Margin="0,0,0,2"/>

                    <!-- 大小 -->
                    <TextBlock Text="{Binding FileSizeDisplay}"
                               FontSize="11"
                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
