<Window x:Class="RePKG.WpfGui.Views.WelcomeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎使用 RePKG GUI"
        Width="480" Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}">

    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Margin="16">
        <StackPanel Margin="32,28">

            <!-- 标题 -->
            <TextBlock Text="🎮" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,12"/>
            <TextBlock Text="RePKG GUI" FontSize="24" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="Wallpaper Engine 壁纸解包工具" FontSize="13"
                       HorizontalAlignment="Center" Margin="0,4,0,24"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>

            <!-- 简介 -->
            <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="6"
                    Padding="14" Margin="0,0,0,20">
                <TextBlock TextWrapping="Wrap" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           LineHeight="20">
                    RePKG GUI 是一款可视化浏览和选择性解包 Wallpaper Engine 壁纸资源的工具。
                    支持缩略图预览、元数据查看、批量筛选和 TEX 纹理转换。
                </TextBlock>
            </Border>

            <!-- 免责声明 -->
            <Border Background="#FFF8E1" CornerRadius="6" Padding="14" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="⚠️ 免责声明" FontSize="13" FontWeight="SemiBold"
                               Foreground="#F57C00" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#795548" LineHeight="18">
                        本工具仅用于处理用户本地已有的文件，解包后的素材版权归原作者所有。
                        请在获得原作者授权后再使用或分发相关内容。
                        本软件仅供个人学习和研究使用。
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- 确认按钮 -->
            <Button Content="我已阅读并同意" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Center" Padding="32,10"
                    Click="OnAcceptClick"/>
        </StackPanel>
    </Border>
</Window>
