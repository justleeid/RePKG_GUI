<Window x:Class="RePKG.WpfGui.Views.WelcomeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="欢迎使用 RePKG GUI"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F3F3F3">

    <Grid Margin="24,20">
        <StackPanel>

                <!-- 标题 -->
                <TextBlock Text="🎮" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="RePKG GUI" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" Foreground="#1A1A1A"/>
                <TextBlock Text="Wallpaper Engine 壁纸解包工具" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,4,0,20"
                           Foreground="#616161"/>

                <!-- 简介 -->
                <Border Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#616161" LineHeight="20">
                        RePKG GUI 是一款可视化浏览和选择性解包 Wallpaper Engine 壁纸资源的工具。
                        支持缩略图预览、元数据查看、批量筛选和 TEX 纹理转换。
                    </TextBlock>
                </Border>

                <!-- 免责声明 -->
                <Border Background="#FFF8E1" CornerRadius="6" Padding="12" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="⚠️ 免责声明" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#F57C00" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#795548" LineHeight="18">
                            本工具仅用于处理用户本地已有的文件，解包后的素材版权归原作者所有。
                            请在获得原作者授权后再使用或分发相关内容。
                            本软件仅供个人学习和研究使用。
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 确认按钮 -->
                <Button x:Name="AcceptButton" Content="我已阅读并同意"
                        Background="#0078D4" Foreground="White"
                        FontSize="14" FontWeight="SemiBold"
                        Padding="40,12" HorizontalAlignment="Center"
                        Cursor="Hand" Click="OnAcceptClick">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#106EBE"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#005A9E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
        </StackPanel>
    </Grid>
</Window>
