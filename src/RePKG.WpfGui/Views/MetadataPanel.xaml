<UserControl x:Class="RePKG.WpfGui.Views.MetadataPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:RePKG.WpfGui.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Border Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="0,1,0,0"
            Padding="16,12">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 预览图 -->
            <Border Grid.Column="0" Width="120" Height="120" CornerRadius="8"
                    Background="#F5F5F5" Margin="0,0,16,0" ClipToBounds="True">
                <Image Source="{Binding PreviewImage}" Stretch="UniformToFill"/>
            </Border>

            <!-- 元数据信息 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <!-- 标题 -->
                <TextBlock Text="{Binding Title}"
                           FontSize="16" FontWeight="SemiBold"
                           Foreground="#1A1A1A"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,8"/>

                <!-- 信息行 -->
                <WrapPanel Margin="0,0,0,8">
                    <!-- 作者 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0"
                                Visibility="{Binding HasAuthor, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="作者 " Foreground="#9E9E9E" FontSize="12"/>
                        <TextBlock FontSize="12">
                            <Hyperlink Command="{Binding OpenAuthorSteamUrlCommand}"
                                       Foreground="#0078D4">
                                <Run Text="{Binding Author}"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <!-- 类型 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="类型 " Foreground="#9E9E9E" FontSize="12"/>
                        <TextBlock FontSize="12">
                            <Run Text="{Binding TypeIcon}"/>
                            <Run Text=" "/>
                            <Run Text="{Binding Type}"/>
                        </TextBlock>
                    </StackPanel>

                    <!-- 大小 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="大小 " Foreground="#9E9E9E" FontSize="12"/>
                        <TextBlock Text="{Binding FileSizeDisplay}" Foreground="#1A1A1A" FontSize="12"/>
                    </StackPanel>

                    <!-- Workshop ID -->
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding HasWorkshopId, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="ID " Foreground="#9E9E9E" FontSize="12"/>
                        <TextBlock FontSize="12">
                            <Hyperlink NavigateUri="{Binding WorkshopUrl}"
                                       Command="{Binding OpenWorkshopUrlCommand}"
                                       Foreground="#0078D4">
                                <Run Text="{Binding WorkshopId}"/>
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </WrapPanel>

                <!-- 标签 -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding HasTags, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="标签 " Foreground="#9E9E9E" FontSize="12" VerticalAlignment="Center"/>
                    <ItemsControl ItemsSource="{Binding Tags}" Margin="4,0,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F0F0F0" CornerRadius="10" Padding="8,3" Margin="0,0,4,0">
                                    <TextBlock Text="{Binding}" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <!-- 操作按钮 -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                <Button Style="{StaticResource ModernButton}"
                        Content="📂 打开文件夹"
                        Command="{Binding OpenContainingFolderCommand}"
                        Padding="12,6" Margin="0,0,0,6"/>
                <Button Style="{StaticResource ModernButton}"
                        Content="🔗 Workshop"
                        Command="{Binding OpenWorkshopUrlCommand}"
                        Padding="12,6" Margin="0,0,0,6"
                        Visibility="{Binding HasWorkshopId, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Button Style="{StaticResource IconButton}"
                        Content="✕ 关闭"
                        Command="{Binding CloseCommand}"
                        Padding="8,4"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
