<UserControl x:Class="RePKG.WpfGui.Views.MetadataPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RePKG.WpfGui.ViewModels"
             xmlns:converters="clr-namespace:RePKG.WpfGui.Converters">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Border Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="0,1,0,0"
            Padding="16">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 预览图 -->
            <Border Grid.Column="0" Width="160" Height="160" CornerRadius="4" Background="#F0F0F0" Margin="0,0,16,0">
                <Image Source="{Binding PreviewImage}" Stretch="UniformToFill"/>
            </Border>

            <!-- 元数据信息 -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <!-- 标题 -->
                <TextBlock Text="{Binding Title}"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="#1A1A1A"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,8"/>

                <!-- 作者 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="作者: " Foreground="#616161"/>
                    <TextBlock>
                        <Hyperlink Command="{Binding OpenAuthorSteamUrlCommand}"
                                   Foreground="#0067C0">
                            <Run Text="{Binding Author}"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

                <!-- 类型 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="类型: " Foreground="#616161"/>
                    <TextBlock>
                        <Run Text="{Binding TypeIcon}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding Type}"/>
                    </TextBlock>
                </StackPanel>

                <!-- 大小 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="大小: " Foreground="#616161"/>
                    <TextBlock Text="{Binding FileSizeDisplay}" Foreground="#1A1A1A"/>
                </StackPanel>

                <!-- Workshop ID -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Workshop ID: " Foreground="#616161"/>
                    <TextBlock>
                        <Hyperlink NavigateUri="{Binding WorkshopUrl}"
                                   Command="{Binding OpenWorkshopUrlCommand}"
                                   Foreground="#0067C0">
                            <Run Text="{Binding WorkshopId, FallbackValue='N/A'}"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

                <!-- 路径 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="路径: " Foreground="#616161"/>
                    <TextBlock Text="{Binding PkgPath}" Foreground="#1A1A1A"
                               TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                </StackPanel>

                <!-- 标签 -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                    <TextBlock Text="标签: " Foreground="#616161"/>
                    <TextBlock Text="{Binding TagsDisplay}" Foreground="#1A1A1A"/>
                </StackPanel>
            </StackPanel>

            <!-- 操作按钮 -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                <Button Content="📂 打开文件夹" Command="{Binding OpenContainingFolderCommand}"
                        Padding="12,8" Margin="0,0,0,8"/>
                <Button Content="🔗 Workshop 页面" Command="{Binding OpenWorkshopUrlCommand}"
                        Padding="12,8" Margin="0,0,0,8"
                        Visibility="{Binding HasWorkshopId, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Button Content="✕ 关闭" Command="{Binding CloseCommand}"
                        Padding="12,8"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
