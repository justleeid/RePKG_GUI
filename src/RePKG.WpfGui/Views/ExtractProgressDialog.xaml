<Window x:Class="RePKG.WpfGui.Views.ExtractProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RePKG.WpfGui.ViewModels"
        Title="正在解包..."
        Width="480" Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F3F3">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Border Background="White" CornerRadius="8" Margin="8">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock Grid.Row="0" Text="正在解包..." FontSize="18" FontWeight="SemiBold"
                       Foreground="#1A1A1A" Margin="0,0,0,20"/>

            <!-- 进度条 -->
            <StackPanel Grid.Row="1" Margin="0,0,0,16">
                <ProgressBar Height="6" Value="{Binding ProgressPercent}" Maximum="100"
                             Background="#E0E0E0" Foreground="#0078D4" Margin="0,0,0,8"/>
                <Grid>
                    <TextBlock Text="{Binding ProgressText}" FontSize="12" Foreground="#616161"
                               HorizontalAlignment="Left"/>
                    <TextBlock Text="{Binding ElapsedTime}" FontSize="12" Foreground="#9E9E9E"
                               HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>

            <!-- 当前项 -->
            <Border Grid.Row="2" Background="#F5F5F5" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                <TextBlock TextWrapping="Wrap" FontSize="12">
                    <Run Text="当前: " Foreground="#9E9E9E"/>
                    <Run Text="{Binding CurrentItemTitle}" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                </TextBlock>
            </Border>

            <!-- 进度列表 -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ExtractProgressItemViewModel}">
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="{Binding StatusIcon}" Foreground="{Binding StatusColor}"
                                           Width="20" TextAlignment="Center" FontSize="12"/>
                                <TextBlock Text="{Binding Title}" Margin="8,0,0,0" FontSize="12"/>
                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}"
                                           Margin="8,0,0,0" FontSize="12"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 结果摘要 -->
            <Border Grid.Row="4" Background="#E6F4EA" CornerRadius="6" Padding="12" Margin="0,0,0,16"
                    Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding ResultSummary}" FontWeight="SemiBold" Foreground="#107C10"
                           FontSize="13"/>
            </Border>

            <!-- 按钮 -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ModernButton}" Content="取消"
                        Command="{Binding CancelCommand}" Padding="24,8" Margin="0,0,12,0"
                        Visibility="{Binding IsExtracting, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Button Style="{StaticResource PrimaryButton}" Content="完成"
                        Command="{Binding CloseCommand}" Padding="24,8"
                        Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
