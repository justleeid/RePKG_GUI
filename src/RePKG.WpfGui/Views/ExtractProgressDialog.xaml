<Window x:Class="RePKG.WpfGui.Views.ExtractProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RePKG.WpfGui.ViewModels"
        Title="正在解包..."
        Width="500" Height="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="📦 正在解包..." FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <!-- 进度条 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <ProgressBar Height="8" Value="{Binding ProgressPercent}" Maximum="100" Margin="0,0,0,8"/>
            <Grid>
                <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding ElapsedTime}" HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>

        <!-- 当前项 -->
        <Border Grid.Row="2" Background="#F0F7FF" CornerRadius="4" Padding="12" Margin="0,0,0,16">
            <TextBlock TextWrapping="Wrap">
                <Run Text="当前: "/>
                <Run Text="{Binding CurrentItemTitle}" FontWeight="SemiBold"/>
            </TextBlock>
        </Border>

        <!-- 进度列表 -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ExtractProgressItemViewModel}">
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="{Binding StatusIcon}" Foreground="{Binding StatusColor}"
                                       Width="24" TextAlignment="Center"/>
                            <TextBlock Text="{Binding Title}" Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}"
                                       Margin="8,0,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 结果摘要 -->
        <Border Grid.Row="4" Background="#F0FFF0" CornerRadius="4" Padding="12" Margin="0,0,0,16"
                Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding ResultSummary}" FontWeight="SemiBold" Foreground="#107C10"/>
        </Border>

        <!-- 按钮 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Command="{Binding CancelCommand}" Padding="24,8" Margin="0,0,12,0"
                    Visibility="{Binding IsExtracting, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <Button Content="完成" Command="{Binding CloseCommand}" Padding="24,8"
                    Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="#0078D4" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
